   "row": {
    "role": "AXCheckBox",
    "title": "",
    "desc": "",
    "help": "If enabled, thick internal bridges will be used. It's usually recommended to have this feature turned on. However, consider turning it off if you are using large nozzles.\nparameter name\t: thick_internal_bridges",
