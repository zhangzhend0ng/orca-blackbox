    "y": 2044.0,
    "w": 20.0,
    "h": 20.0,
    "key": "only_one_wall_top",
    "states": [
     "flat_advanced",
     "flat_return"
    ]
   }
  },
  {
   "mode": "flat",
   "row": {
    "role": "AXTextField",
    "title": "",
    "desc": "",
    "help": "If a top surface has to be printed and it's partially covered by another layer, it won't be considered at a top layer where its width is below this value. This can be useful to not let the 'one perimeter on top' trigger on surface that should be covered only by perimeters. This value can be a mm or a % of the perimeter extrusion width.\nWarning: If enabled, artifacts can be created if you have some thin features on the next layer, like letters. Set this setting to 0 to remove these artifacts.\nparameter name\t: min_width_top_surface",
    "ident": "",
    "placeholder": "",
    "value": "200%",
    "role_desc": "text field",
    "value_num": null,
    "enabled": true,
    "x": 612.0,
    "y": 2072.0,
    "w": 55.0,
    "h": 19.0,
    "key": "min_width_top_surface",
    "states": [
     "flat_advanced",
     "flat_return"
    ]
   }
  },
  {
   "mode": "flat",
   "row": {
    "role": "AXCheckBox",
    "title": "",
    "desc": "",
    "help": "Use only one wall on first layer, to give more space to the bottom infill pattern.\nparameter name\t: only_one_wall_first_layer",
    "ident": "",
    "placeholder": "",
    "value": "",
    "role_desc": "toggle button",
    "value_num": null,
    "enabled": true,
    "x": 605.0,
